# Dev: leave empty — Vite proxy handles /api → http://localhost:5000 automatically
VITE_API_URL=

# Clerk publishable key (https://dashboard.clerk.com → API keys)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Production (Vercel): set this in Vercel's env vars, not in your local .env
# VITE_API_URL=https://leadserver.vercel.app
